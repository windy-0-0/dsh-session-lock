{
  "name": "@dsh-external/dsh-session-lock",
  "version": "0.1.2",
  "description": "DeepSeek Harness 会话互斥锁：Web Locks 跨标签页互斥，防止多页面并发编辑同一会话导致草稿互相覆盖，支持一键接管",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib/client.js",
    "lib/client.js.map",
    "lib/index.js",
    "lib/index.js.map",
    "lib/types",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windy-0-0/dsh-session-lock.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-lock",
    "web-locks"
  ],
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "cordis": "4.0.0-rc.8",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown",
    "build:all": "npm run build && npm run build:client"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}